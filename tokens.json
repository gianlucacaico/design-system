---
# The kit's colour, card art and layout tokens as JSON, laid out like the W3C design tokens
# format ($type, $value, $description). Built from _data/kit.yml. gianlucacaico.com's drift check
# reads this file to compare the site with the design system, so keep the shape stable.
# source: "site" tokens must match the site's stylesheet; "artwork" tokens live in its drawings.
---
{%- assign colours = "" | split: "" %}
{%- for g in site.data.kit.colours %}{% for t in g.tokens %}{% assign colours = colours | push: t %}{% endfor %}{% endfor %}
{
  "$description": "GC kit design tokens, reverse engineered from gianlucacaico.com. Docs: https://gianlucacaico.com/design-system/",
  "color": {
{%- assign i = 0 %}
{%- for g in site.data.kit.colours %}{% for t in g.tokens %}{% assign i = i | plus: 1 %}
    {{ t.name | jsonify }}: {"$type": "color", "$value": {{ t.value | jsonify }}, "$description": {{ t.use | jsonify }}, "$extensions": {"com.gianlucacaico.kit": {"group": {{ g.group | jsonify }}, "source": {{ g.source | default: "site" | jsonify }}}}}{% if i < colours.size %},{% endif %}
{%- endfor %}{% endfor %}
  },
  "art": {
{%- for t in site.data.kit.art %}
    {{ t.name | jsonify }}: {"$value": {{ t.value | jsonify }}, "$description": {{ t.use | jsonify }}, "$extensions": {"com.gianlucacaico.kit": {"source": "site"}}}{% unless forloop.last %},{% endunless %}
{%- endfor %}
  },
  "layout": {
{%- for t in site.data.kit.layout %}
    {{ t.name | jsonify }}: {"$type": "dimension", "$value": {{ t.value | jsonify }}, "$description": {{ t.use | jsonify }}, "$extensions": {"com.gianlucacaico.kit": {"source": {% if t.name == "max" %}"site"{% else %}"kit"{% endif %}}}}{% unless forloop.last %},{% endunless %}
{%- endfor %}
  }
}
